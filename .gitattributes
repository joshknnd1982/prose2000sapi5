# Most of this repository by weight is voice data and engine binaries. Marking them
# explicitly means git never applies end-of-line conversion to them, whatever the
# checkout platform's defaults are.
* text=auto

*.dll  binary
*.exe  binary
*.wav  binary
*.bin  binary
*.ico  binary

# The Prose firmware ROM images. These carry no extension git recognises and some of them
# contain long runs of printable bytes, so without these lines "* text=auto" can decide a
# ROM is a text file and rewrite its line endings on checkout - which silently corrupts the
# firmware and leaves the emulator refusing to start.
*.u21  binary
*.u22  binary
*.u29  binary
*.u44  binary
*.u45  binary

# Batch files are read by cmd.exe, which is unreliable with LF-only line endings in
# parenthesised blocks and for loops.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Inno Setup compiles these; keep them in the form the compiler expects.
*.iss  text eol=crlf
